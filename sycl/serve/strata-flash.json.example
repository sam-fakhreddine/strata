{
  "engine": "strata",
  "backend": "sycl",
  "model_name": "qwen3.8-flash-next-iq2_xs",
  "exe": "/opt/llm/strata/Strata/sycl/serve/strata-native.sh",
  "cwd": "/opt/llm/strata/Strata",
  "log": "/opt/llm/strata/Strata/strata-flash.log",
  "tokenizer": "/opt/llm/strata/pack/tokenizer",
  "args": [
    "--pack", "/opt/llm/strata/pack",
    "--native", "/opt/llm/strata/models/Qwen3.8-Flash-Next-GSQ-RCO-IQ2_XS-00001-of-00002.gguf",
    "--ple-gguf", "/opt/llm/strata/models/Qwen3.8-Flash-Next-GSQ-RCO-IQ2_XS-00002-of-00002.gguf",
    "--expert-profile", "/opt/llm/strata/Strata/data/expert-profile.bin",
    "--expert-cache", "auto",
    "--stream-experts",
    "--prefill", "4096",
    "--spec", "4",
    "--spec-min-p", "0.5",
    "--mtp", "/opt/llm/strata/mtp/rt",
    "--max-context", "32768",
    "--kv", "int8",
    "--vram-reserve-mib", "1024",
    "--ple-io", "direct"
  ],
  "env": {
    "STRATA_VERIFY_NO_HOST": "1",
    "STRATA_VERIFY_DEVICE_PLAN": "1"
  },
  "sampling": {
    "temperature": 0.6,
    "top_p": 0.95,
    "top_k": 20,
    "repetition_penalty": 1.05
  }
}
